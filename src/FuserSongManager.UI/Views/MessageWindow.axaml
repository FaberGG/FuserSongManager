<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FuserSongManager.UI.Views.MessageWindow"
        Width="480" SizeToContent="Height" MaxHeight="560"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Classes="accent" MinWidth="88" IsDefault="True" HorizontalContentAlignment="Center" />
            <Button x:Name="CancelButton" MinWidth="88" IsCancel="True" HorizontalContentAlignment="Center" />
        </StackPanel>
        <ScrollViewer>
            <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</Window>
