<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FuserSongManager.UI.ViewModels"
        xmlns:c="using:FuserSongManager.UI.Controls"
        xmlns:ui="using:FuserSongManager.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FuserSongManager.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="Fuser Song Manager"
        Width="1440" Height="900" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <c:NightSky />

        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,24,32,0">

            <!-- ===== Header: title, search, help, settings, more, Play Fuser ===== -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                <TextBlock Classes="h1" Text="Custom Songs" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" Width="400" HorizontalAlignment="Left"
                         Text="{Binding SearchText}" PlaceholderText="Search title, artist, author or notes  (Ctrl+F)">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource Ui.Search}" Width="18" Height="18" Margin="14,0,4,0" Foreground="{StaticResource Fsm.Ink3}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="warning" Text="{Binding FileActionsHint}" MaxWidth="300" VerticalAlignment="Center" TextAlignment="Right"
                               IsVisible="{Binding FileActionsHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Classes="icon" Command="{Binding ShowHelpCommand}" ToolTip.Tip="Keyboard shortcuts and help"
                            AutomationProperties.Name="Help">
                        <TextBlock Text="?" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                        <PathIcon Data="{StaticResource Ui.Settings}" />
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Import, rescan and more" AutomationProperties.Name="More actions">
                        <PathIcon Data="{StaticResource Ui.More}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Import songs…" InputGesture="Ctrl+I" Command="{Binding ImportCommand}" />
                                <MenuItem Header="Import as disabled…" Command="{Binding ImportDisabledCommand}" />
                                <Separator />
                                <MenuItem Header="Rescan the library" InputGesture="F5" Command="{Binding RescanCommand}" />
                                <MenuItem Header="Read every song again" Command="{Binding FullRescanCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="primary" MinWidth="230" HorizontalContentAlignment="Stretch" Command="{Binding LaunchGameCommand}"
                            ToolTip.Tip="Clears the game's custom song cache and starts Fuser">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <TextBlock Text="Play Fuser" VerticalAlignment="Center" />
                            <PathIcon Grid.Column="1" Data="{StaticResource Ui.Play}" Width="20" Height="20" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Tabs, sort and filters ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,14">
                <Border Background="#9E3A2268" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding StatusTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusTabViewModel">
                                <Button Classes="tab" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsVisible}"
                                        Command="{Binding SelectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource Fsm.Ink3}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="link" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding HasFilter}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="230"
                              AutomationProperties.Name="Sort by" />
                    <ComboBox ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre}" MinWidth="210"
                              AutomationProperties.Name="Genre" />
                    <ComboBox ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding SelectedRating}" MinWidth="200"
                              AutomationProperties.Name="Rating" />
                </StackPanel>
            </Grid>

            <!-- ===== Library grid and the selected song ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <Panel>
                    <ScrollViewer x:Name="GridScroller" HorizontalScrollBarVisibility="Disabled" Padding="0,6,14,6" Focusable="True">
                        <ItemsControl x:Name="TileList" ItemsSource="{Binding TileRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TileRow">
                                    <ItemsControl ItemsSource="{Binding Songs}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:TileRowPanel Columns="{Binding Columns}" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SongRowViewModel">
                                                <Button Classes="tile" Classes.selected="{Binding IsSelected}" Classes.off="{Binding IsDisabled}"
                                                        Click="OnTileClick" Loaded="OnTileLoaded" DataContextChanged="OnTileDataContextChanged"
                                                        ToolTip.Tip="{Binding Problem}" ToolTip.ShowDelay="600"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Panel>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Border IsVisible="{Binding ShowPlaceholder}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#2A1D4F" Offset="0" />
                                                                    <GradientStop Color="#120D26" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <PathIcon Data="{StaticResource Ui.Music}" Width="56" Height="56" Foreground="#40FFFFFF" />
                                                        </Border>
                                                        <Border Background="{StaticResource Fsm.TileShade}" />
                                                        <!-- Disabled songs are darker, so the enabled set stands out. -->
                                                        <Border Background="#99080414" IsVisible="{Binding IsDisabled}" />

                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                            <Border Background="#99000000" CornerRadius="4" Padding="7,2" IsVisible="{Binding IsDisabled}">
                                                                <TextBlock Text="DISABLED" FontSize="11" FontWeight="ExtraBold" LetterSpacing="0.6" Foreground="#E2DAF6" />
                                                            </Border>
                                                            <Border Background="#CC2A1A00" CornerRadius="4" Padding="5,2" IsVisible="{Binding HasProblem}">
                                                                <PathIcon Data="{StaticResource Ui.Warning}" Width="14" Height="14" Foreground="{StaticResource Fsm.Warning}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Width="30" Height="30" CornerRadius="15" Background="#E6FFFFFF" Margin="8"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsSelected}">
                                                            <PathIcon Data="{StaticResource Ui.Check}" Width="18" Height="18" Foreground="#3B2A6E" />
                                                        </Border>

                                                        <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,10" Spacing="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="ExtraBold" TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Artist}" FontSize="15" FontWeight="Medium" TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Foreground="#EEEEEE" />
                                                            <StackPanel Classes="more" Spacing="4">
                                                                <TextBlock Text="{Binding GenreAndYear}" FontSize="14" TextAlignment="Center" Foreground="#DDDDDD"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                <ItemsControl ItemsSource="{Binding Parts}" HorizontalAlignment="Center">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="9" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:PartIcon">
                                                                            <Panel Width="20" Height="20">
                                                                                <Path Data="{Binding Instrument, Converter={x:Static ui:Converters.InstrumentGeometry}}"
                                                                                      Fill="{Binding Kind, Converter={x:Static ui:Converters.PartBrush}}" Stretch="Uniform" />
                                                                            </Panel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Panel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Classes="hint" Text="{Binding EmptyText}" TextAlignment="Center" MaxWidth="420" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>

                <!-- ===== Side panel ===== -->
                <Border Grid.Column="1" Classes="panel" Width="400" Margin="0,6,0,12">
                    <Panel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="30"
                                    IsVisible="{Binding HasNoSelection}">
                            <PathIcon Data="{StaticResource Ui.Music}" Width="64" Height="64" Foreground="#40FFFFFF" />
                            <TextBlock Classes="hint" Text="Select a song to see it, listen to it, and rate it." TextAlignment="Center" FontSize="16" />
                            <TextBlock Classes="hint" Text="Ctrl+click or Shift+click selects several." TextAlignment="Center" FontSize="13" />
                        </StackPanel>

                        <!-- Several songs selected: only the actions that apply to all of them. -->
                        <StackPanel VerticalAlignment="Center" Margin="28" Spacing="14" IsVisible="{Binding HasMultipleSelection}">
                            <TextBlock Classes="h2" Text="{Binding SelectionText}" TextAlignment="Center" />
                            <TextBlock Classes="hint" Text="Enable or disable them all at once." TextAlignment="Center" />
                            <Button Content="Enable all" Command="{Binding EnableSelectedCommand}" HorizontalAlignment="Stretch" MinHeight="48" />
                            <Button Content="Disable all" Command="{Binding DisableSelectedCommand}" HorizontalAlignment="Stretch" MinHeight="48" />
                        </StackPanel>

                        <ContentControl Content="{Binding Detail}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:SongDetailViewModel">
                                    <ScrollViewer x:Name="DetailScroller" Padding="20,20,20,20">
                                        <StackPanel Spacing="16">
                                            <!-- Album art (RF-PEN-14), with a placeholder that says why there is none. -->
                                            <Border CornerRadius="6" ClipToBounds="True" Height="{Binding $self.Bounds.Width}" Background="#120D26">
                                                <Panel>
                                                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"
                                                           IsVisible="{Binding AlbumArt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                                                IsVisible="{Binding AlbumArt, Converter={x:Static ObjectConverters.IsNull}}">
                                                        <PathIcon Data="{StaticResource Ui.Music}" Width="84" Height="84" Foreground="#40FFFFFF" />
                                                        <TextBlock Classes="hint" Text="{Binding ArtMessage}" TextAlignment="Center" MaxWidth="240" />
                                                    </StackPanel>
                                                </Panel>
                                            </Border>

                                            <StackPanel Spacing="2">
                                                <SelectableTextBlock Text="{Binding Title}" FontSize="26" FontWeight="ExtraBold" TextWrapping="Wrap" />
                                                <SelectableTextBlock Text="{Binding Artist}" FontSize="18" Foreground="{StaticResource Fsm.Ink2}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Border Classes="chip" Margin="0,0,6,6" IsVisible="{Binding Row.Genre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding Row.Genre}" />
                                                    </Border>
                                                    <Border Classes="chip" Margin="0,0,6,6" IsVisible="{Binding Row.Year, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <TextBlock Text="{Binding Row.Year}" />
                                                    </Border>
                                                    <Border Classes="chip" Margin="0,0,6,6" IsVisible="{Binding BpmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding BpmText}" />
                                                    </Border>
                                                    <Border Classes="chip" Margin="0,0,6,6" IsVisible="{Binding KeyAndMode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding KeyAndMode}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <Border Classes="problem" IsVisible="{Binding HasProblem}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <PathIcon Data="{StaticResource Ui.Warning}" Width="18" Height="18" Foreground="{StaticResource Fsm.Warning}" VerticalAlignment="Top" />
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Problem}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>

                                            <!-- Preview (RF-PEN-13): looped, with the four parts as the game's discs. -->
                                            <ContentControl Content="{Binding Player}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:PlayerViewModel">
                                                        <StackPanel Spacing="12">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                                <Button Classes="play" Command="{Binding PlayPauseCommand}"
                                                                        ToolTip.Tip="Listen to the song in a loop, as it plays in the game (Space)"
                                                                        AutomationProperties.Name="{Binding PlayPauseText}">
                                                                    <Panel>
                                                                        <PathIcon Data="{StaticResource Ui.Play}" Width="24" Height="24" Margin="3,0,0,0"
                                                                                  IsVisible="{Binding !IsPlaying}" />
                                                                        <PathIcon Data="{StaticResource Ui.Pause}" Width="22" Height="22"
                                                                                  IsVisible="{Binding IsPlaying}" />
                                                                    </Panel>
                                                                </Button>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{Binding TimeText}" FontSize="16" FontWeight="Bold" FontFeatures="tnum" />
                                                                    <TextBlock Classes="hint" Text="{Binding BarText}" FontSize="13" FontFeatures="tnum" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <c:LoopTimeline Height="30" Position="{Binding PositionSeconds}" Duration="{Binding DurationSeconds}"
                                                                            BarCount="{Binding BarCount}" CanSeek="{Binding CanSeek}"
                                                                            ToolTip.Tip="One mark per bar; the tall ones start each phrase. Click to jump." />
                                                            <ItemsControl ItemsSource="{Binding Stems}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:StemToggleViewModel">
                                                                        <ToggleButton Classes="disc" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsAvailable}"
                                                                                      ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                                                                            <StackPanel Spacing="6">
                                                                                <Panel Width="74" Height="74" HorizontalAlignment="Center">
                                                                                    <Ellipse Classes="focus" Margin="-4" Stroke="White" StrokeThickness="2" IsVisible="False" />
                                                                                    <Border Classes="plate" Classes.spin="{Binding IsSpinning}" Classes.muted="{Binding !IsOn}"
                                                                                            CornerRadius="37" Background="{Binding Kind, Converter={x:Static ui:Converters.PartBrush}}"
                                                                                            RenderTransformOrigin="50%,50%">
                                                                                        <Border.RenderTransform>
                                                                                            <RotateTransform />
                                                                                        </Border.RenderTransform>
                                                                                        <Panel>
                                                                                            <Ellipse>
                                                                                                <Ellipse.Fill>
                                                                                                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%" RadiusX="55%" RadiusY="55%">
                                                                                                        <GradientStop Color="#8CFFFFFF" Offset="0" />
                                                                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                                                                    </RadialGradientBrush>
                                                                                                </Ellipse.Fill>
                                                                                            </Ellipse>
                                                                                            <Ellipse Margin="7" Stroke="#47FFFFFF" StrokeThickness="1" />
                                                                                            <Ellipse Margin="12" Stroke="#1F000000" StrokeThickness="5" />
                                                                                            <Ellipse Classes="shine" Fill="#26FFFFFF" Opacity="0" />
                                                                                            <Border Width="36" Height="36" CornerRadius="18" Background="#E0140C28"
                                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <Path Data="{Binding IconKey, Converter={x:Static ui:Converters.IconGeometry}}"
                                                                                                      Fill="{Binding Kind, Converter={x:Static ui:Converters.PartBrush}}"
                                                                                                      Stretch="Uniform" Margin="7" />
                                                                                            </Border>
                                                                                        </Panel>
                                                                                    </Border>
                                                                                </Panel>
                                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                                <TextBlock Text="{Binding InstrumentName}" FontSize="11" Foreground="{StaticResource Fsm.Ink3}"
                                                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-4,0,0" />
                                                                            </StackPanel>
                                                                        </ToggleButton>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Classes="warning" Text="{Binding Message}"
                                                                       IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>

                                            <Border Height="1" Background="{StaticResource Fsm.Divider}" />

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="label" Text="YOUR RATING" />
                                                <ItemsControl ItemsSource="{Binding StarSlots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StarSlot">
                                                            <Button Classes="star" Classes.on="{Binding Filled}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).SetRatingCommand}"
                                                                    CommandParameter="{Binding Value}"
                                                                    ToolTip.Tip="Click the current rating again to clear it"
                                                                    AutomationProperties.Name="{Binding Value, StringFormat='Rate {0} of 5'}">
                                                                <PathIcon Data="{StaticResource Ui.Star}" Width="26" Height="26" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="label" Text="CUSTOM SONG AUTHOR" />
                                                <TextBox Text="{Binding Author, UpdateSourceTrigger=LostFocus}" PlaceholderText="Who made this custom song" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="label" Text="NOTES" />
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="72" MaxHeight="200" PlaceholderText="Anything worth remembering" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <SelectableTextBlock Text="{Binding FileName}" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Classes="hint" FontSize="12" Text="{Binding FolderName, StringFormat='In {0}'}" ToolTip.Tip="{Binding Location}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="quiet" Command="{Binding OpenFolderCommand}" MinHeight="36"
                                                        IsEnabled="{Binding FullPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                        ToolTip.Tip="Show the file in Explorer">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon Data="{StaticResource Ui.Folder}" Width="16" Height="16" />
                                                        <TextBlock Text="Show" FontSize="14" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <Button MinHeight="50" FontSize="17" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleSelectedEnabledCommand}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding EnableActionText}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="keycap" Margin="0"><TextBlock Text="Enter" /></Border>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Panel>
                </Border>
            </Grid>

            <!-- ===== Keyboard shortcuts and status ===== -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,4,0,20">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="key" Command="{Binding ToggleAutoplayCommand}" Focusable="False"
                            ToolTip.Tip="Play the song as soon as you select it">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="keycap" Classes.on="{Binding IsAutoplayOn}"><TextBlock Text="Z" /></Border>
                            <TextBlock Text="Autoplay: " VerticalAlignment="Center" />
                            <TextBlock Text="On" VerticalAlignment="Center" IsVisible="{Binding IsAutoplayOn}" />
                            <TextBlock Text="Off" VerticalAlignment="Center" IsVisible="{Binding !IsAutoplayOn}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="key" Command="{Binding PlayPauseCommand}" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="keycap"><TextBlock Text="Space" /></Border>
                            <TextBlock Text="Play / Pause" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="key" Command="{Binding ToggleSelectedEnabledCommand}" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="keycap"><TextBlock Text="Enter" /></Border>
                            <TextBlock Text="Enable / Disable" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="key" Command="{Binding ImportCommand}" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="keycap"><TextBlock Text="Ctrl+I" /></Border>
                            <TextBlock Text="Import" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="key" Command="{Binding RescanCommand}" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="keycap"><TextBlock Text="F5" /></Border>
                            <TextBlock Text="Rescan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{Binding StatusText}" />
                <ProgressBar Grid.Column="2" Width="180" VerticalAlignment="Center"
                             IsVisible="{Binding IsProgressVisible}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
            </Grid>
        </Grid>
    </Panel>
</Window>
