<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FuserSongManager.UI.ViewModels"
             x:Class="FuserSongManager.UI.Views.FuserSettingsView"
             x:DataType="vm:SettingsViewModel">
    <!-- Shared by the first-run wizard and the Settings window. -->
    <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="FUSER FOLDER" Margin="0" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding FuserDirectory}" PlaceholderText="C:\Program Files (x86)\Steam\steamapps\common\Fuser" />
            <Button Grid.Column="1" Classes="coral quiet" Content="Browse…" Command="{Binding BrowseFolderCommand}" />
        </Grid>
        <TextBlock Classes="error" Text="{Binding FolderError}" IsVisible="{Binding FolderError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="hint" Text="{Binding FolderInfo}" IsVisible="{Binding FolderInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Classes="section" Text="START FUSER WITH" />
        <ComboBox ItemsSource="{Binding LauncherTypes}" SelectedItem="{Binding LauncherType}" MinWidth="220" HorizontalAlignment="Left" />
        <TextBlock Classes="hint" Text="{Binding LauncherNote}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsExecutableNeeded}">
            <TextBox Text="{Binding ExecutablePath}" PlaceholderText="Fuser.exe or a .bat script" />
            <Button Grid.Column="1" Classes="coral quiet" Content="Browse…" Command="{Binding BrowseExecutableCommand}" />
        </Grid>
        <TextBlock Classes="error" Text="{Binding ExecutableError}" IsVisible="{Binding ExecutableError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
