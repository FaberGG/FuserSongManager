<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FuserSongManager.UI.Controls">
    <!--
        The look of Fuser's own menus (its crate screen in particular): deep purple panels over a blurred night sky,
        small rounded corners, Kumbh Sans, and buttons whose hover colour sweeps off to the right with a wave.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FuserSongManager/Themes/InstrumentIcons.axaml" />
                <ResourceInclude Source="avares://FuserSongManager/Themes/UiIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="Fsm.Font">avares://FuserSongManager/Assets/Fonts#Kumbh Sans</FontFamily>

            <SolidColorBrush x:Key="Fsm.Background" Color="#080B20" />
            <SolidColorBrush x:Key="Fsm.Ink" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fsm.Ink2" Color="#E2DAF6" />
            <SolidColorBrush x:Key="Fsm.Ink3" Color="#AFA3D6" />
            <SolidColorBrush x:Key="Fsm.Panel" Color="#B8261846" />
            <SolidColorBrush x:Key="Fsm.Panel2" Color="#C73A2268" />
            <SolidColorBrush x:Key="Fsm.Popup" Color="#F7181030" />
            <SolidColorBrush x:Key="Fsm.Field" Color="#8C0A0618" />
            <SolidColorBrush x:Key="Fsm.Divider" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Fsm.Warning" Color="#FFC078" />
            <SolidColorBrush x:Key="Fsm.Error" Color="#FF8A8A" />
            <SolidColorBrush x:Key="Fsm.Gold" Color="#FFD24A" />

            <!-- The four parts, in the colours of the game's discs (normal colour mode, not the colour-blind one). -->
            <SolidColorBrush x:Key="Fsm.Part.Beat" Color="#00BADD" />
            <SolidColorBrush x:Key="Fsm.Part.Bass" Color="#54CC1F" />
            <SolidColorBrush x:Key="Fsm.Part.Loop" Color="#EBDF35" />
            <SolidColorBrush x:Key="Fsm.Part.Lead" Color="#EE1E31" />

            <!-- Hover sweeps: violet in the library (crate), coral in dialogs, blue for list options. -->
            <LinearGradientBrush x:Key="Fsm.Sweep.Violet" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#6C55EE" Offset="0" />
                <GradientStop Color="#9D84F6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Fsm.Sweep.Coral" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FF5A55" Offset="0" />
                <GradientStop Color="#D63FB4" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Fsm.Sweep.Blue" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#3E55E6" Offset="0" />
                <GradientStop Color="#6B7BFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Fsm.Selected" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#C0399B" Offset="0" />
                <GradientStop Color="#7D3FD0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Fsm.TileShade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00000000" Offset="0.38" />
                <GradientStop Color="#E0080414" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Text ===== -->

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource Fsm.Font}" />
        <Setter Property="Background" Value="{StaticResource Fsm.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink3}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink3}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.warning, SelectableTextBlock.warning">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Warning}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Panels ===== -->

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource Fsm.Panel}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink2}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.problem">
        <Setter Property="Background" Value="#26FFA94D" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ===== Buttons: the sweep ===== -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource Fsm.Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True">
                    <Panel>
                        <c:SweepFill Name="Sweep" Fill="{StaticResource Fsm.Sweep.Violet}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Fluent paints the presenter in each state (its state styles win over a plain one, so every state is listed);
         here the colour comes from the sweep and the control's own background only. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter,
                     Button:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:checked /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:checked:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.disc:checked:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pointerover /template/ c|SweepFill#Sweep, Button:focus-visible /template/ c|SweepFill#Sweep">
        <Setter Property="IsActive" Value="True" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.coral">
        <Setter Property="Background" Value="#BF5C2C5A" />
    </Style>
    <Style Selector="Button.coral /template/ c|SweepFill#Sweep">
        <Setter Property="Fill" Value="{StaticResource Fsm.Sweep.Coral}" />
    </Style>
    <Style Selector="Button.quiet, Button.coral.quiet">
        <Setter Property="Background" Value="#14FFFFFF" />
    </Style>

    <!-- The big action of a screen: Play Fuser. -->
    <Style Selector="Button.primary">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Round icon buttons (help, settings, more). -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>

    <!-- Text-only button. -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#C9B8FF" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- Tabs over the library. -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="Button.tab.selected">
        <Setter Property="Background" Value="#24FFFFFF" />
    </Style>

    <!-- Keyboard shortcuts at the bottom, drawn as keys like the game's prompts. -->
    <Style Selector="Button.key">
        <Setter Property="Background" Value="#BF281A50" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="5,0,10,0" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.keycap">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap > TextBlock">
        <Setter Property="Foreground" Value="#1A1238" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap.on">
        <Setter Property="Background" Value="#9D84F6" />
    </Style>
    <Style Selector="Border.keycap.on > TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Stars of the rating: no background, no sweep. -->
    <Style Selector="Button.star">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="#5E4F8A" />
    </Style>
    <Style Selector="Button.star /template/ c|SweepFill#Sweep">
        <Setter Property="Fill" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.star.on">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Gold}" />
    </Style>
    <Style Selector="Button.star:pointerover">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Round play button of the preview. -->
    <Style Selector="Button.play">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#2A1A55" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play /template/ c|SweepFill#Sweep">
        <Setter Property="Fill" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.play:pointerover">
        <Setter Property="Background" Value="#E8E0FF" />
    </Style>

    <!-- ===== Song tiles ===== -->

    <Style Selector="Button.tile">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="#140F2A" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Glow" CornerRadius="{TemplateBinding CornerRadius}" Background="#140F2A"
                            BoxShadow="0 0 26 2 #B3AA82FF" IsVisible="False" />
                    <Border Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Border>
                    <Border Name="Ring" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="White" BorderThickness="3" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.tile:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.035)" />
        <Setter Property="ZIndex" Value="3" />
    </Style>
    <Style Selector="Button.tile:pressed">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tile.selected">
        <Setter Property="ZIndex" Value="2" />
    </Style>
    <Style Selector="Button.tile.selected /template/ Border#Ring, Button.tile.selected /template/ Border#Glow">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.tile:focus-visible /template/ Border#Ring">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="BorderBrush" Value="#C9B8FF" />
    </Style>
    <!-- Genre, year and instruments slide in on hover, as in the crate. -->
    <Style Selector="Button.tile StackPanel.more">
        <Setter Property="MaxHeight" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tile:pointerover StackPanel.more">
        <Setter Property="MaxHeight" Value="52" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===== Discs of the preview ===== -->

    <Style Selector="ToggleButton.disc">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.disc:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!-- Each plate has its own RotateTransform (see the disc template in MainWindow); the animation turns it. -->
    <Style Selector="ToggleButton.disc Border.plate.spin">
        <Style.Animations>
            <Animation Duration="0:0:1.8" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ToggleButton.disc Border.plate.muted">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="ToggleButton.disc:pointerover Ellipse.shine">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.disc:focus-visible Ellipse.focus">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ===== Text boxes ===== -->

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,11,12,11" />
    </Style>

    <!-- ===== Drop-down lists, like the crate's "Sorted by Title" ===== -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource Fsm.Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MaxDropDownHeight" Value="440" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Background" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <Panel>
                            <c:SweepFill Name="Sweep" Fill="{StaticResource Fsm.Sweep.Violet}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="{TemplateBinding Padding}">
                                <ContentControl Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"
                                                Foreground="{TemplateBinding Foreground}" />
                                <PathIcon Grid.Column="1" Data="{StaticResource Ui.ChevronDown}" Width="16" Height="16"
                                          Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            </Grid>
                        </Panel>
                    </Border>
                    <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="Background" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                           IsLightDismissEnabled="True" InheritsTransform="True">
                        <Border Background="{StaticResource Fsm.Popup}" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ c|SweepFill#Sweep, ComboBox:focus-visible /template/ c|SweepFill#Sweep, ComboBox:dropdownopen /template/ c|SweepFill#Sweep">
        <Setter Property="IsActive" Value="True" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Fsm.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}" ClipToBounds="True" MinHeight="{TemplateBinding MinHeight}">
                    <Panel>
                        <c:SweepFill Name="Sweep" Fill="{StaticResource Fsm.Sweep.Blue}" />
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ c|SweepFill#Sweep, ComboBoxItem:focus-visible /template/ c|SweepFill#Sweep">
        <Setter Property="IsActive" Value="True" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource Fsm.Selected}" />
    </Style>

    <!-- ===== Menus and tooltips ===== -->

    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</Styles>
